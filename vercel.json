{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "destination": "/dist/index.html"
    },
    {
      "source": "/booking",
      "destination": "/dist/booking/index.html"
    },
    {
      "source": "/booking/",
      "destination": "/dist/booking/index.html"
    },
    {
      "source": "/journal",
      "destination": "/dist/journal/index.html"
    },
    {
      "source": "/journal/",
      "destination": "/dist/journal/index.html"
    },
    {
      "source": "/journal/:slug",
      "destination": "/dist/journal/:slug/index.html"
    },
    {
      "source": "/journal/:slug/",
      "destination": "/dist/journal/:slug/index.html"
    },
    {
      "source": "/work",
      "destination": "/dist/work/index.html"
    },
    {
      "source": "/work/",
      "destination": "/dist/work/index.html"
    },
    {
      "source": "/work/:slug",
      "destination": "/dist/work/:slug/index.html"
    },
    {
      "source": "/work/:slug/",
      "destination": "/dist/work/:slug/index.html"
    },
    {
      "source": "/studio",
      "destination": "/dist/studio/index.html"
    },
    {
      "source": "/studio/",
      "destination": "/dist/studio/index.html"
    },
    {
      "source": "/capabilities",
      "destination": "/dist/capabilities/index.html"
    },
    {
      "source": "/capabilities/",
      "destination": "/dist/capabilities/index.html"
    },
    {
      "source": "/enquiries",
      "destination": "/dist/enquiries/index.html"
    },
    {
      "source": "/enquiries/",
      "destination": "/dist/enquiries/index.html"
    },
    {
      "source": "/manage",
      "destination": "/dist/manage/index.html"
    },
    {
      "source": "/manage/",
      "destination": "/dist/manage/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/dist/privacy/index.html"
    },
    {
      "source": "/privacy/",
      "destination": "/dist/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/dist/terms/index.html"
    },
    {
      "source": "/terms/",
      "destination": "/dist/terms/index.html"
    },
    {
      "source": "/assets/:path*",
      "destination": "/dist/assets/:path*"
    },
    {
      "source": "/robots.txt",
      "destination": "/dist/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/dist/sitemap.xml"
    },
    {
      "source": "/site.webmanifest",
      "destination": "/dist/site.webmanifest"
    }
  ]
}
