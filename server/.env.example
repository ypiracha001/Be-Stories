# =============================================================================
# be stories. — server environment
# Copy to .env, fill in, and NEVER commit. .env is gitignored.
# Every value here is read server-side only; none of it reaches the browser.
# =============================================================================

# ---- Google Workspace identity ---------------------------------------------
# The Workspace account that owns the booking calendar and organises every
# event. Bookings land here; Meet links are created under this account.
GOOGLE_ACCOUNT=admin@bestories.co.uk

# 'primary' means admin@bestories.co.uk's own calendar. To use a dedicated
# calendar instead, paste its Calendar ID from Google Calendar >
# Settings > [calendar] > Integrate calendar > Calendar ID.
CALENDAR_ID=primary

# ---- OAuth scopes -----------------------------------------------------------
# Minimum this implementation needs. calendar.events alone is NOT enough:
# freebusy.query (availability + double-booking) is not covered by it.
#   calendar.events          create / move / delete the booking, create the Meet
#   calendar.freebusy        read availability on admin@'s own calendars
# If CALENDAR_ID is a calendar admin@ does not own but has access to, use
# calendar.events.freebusy instead of calendar.freebusy.
OAUTH_SCOPES=https://www.googleapis.com/auth/calendar.events https://www.googleapis.com/auth/calendar.freebusy

# ---- Google OAuth (server-side only) ----------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://bestories.co.uk/oauth2/callback
# Produced once by `node --env-file=.env auth.js`. Never expires unless revoked,
# PROVIDED the OAuth consent screen is Internal or Published (not Testing).
GOOGLE_REFRESH_TOKEN=

# ---- Correspondence ---------------------------------------------------------
# Public inbox used as the From/Reply-To on studio mail. Not the calendar identity.
STUDIO_EMAIL=enquiries@bestories.co.uk
# Optional extra internal invitees on every booking, comma separated.
# The calendar owner is already the organiser and does not need listing.
STUDIO_ATTENDEES=

# ---- Booking rules ----------------------------------------------------------
BOOKING_TZ=Europe/London
WORK_START=10:00
WORK_END=17:00
SLOT_MINUTES=30
LEAD_HOURS=18
HORIZON_DAYS=45

# ---- Enquiry relay ----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Manage links (reschedule / cancel) -------------------------------------
# Any long random string: openssl rand -base64 48
MANAGE_SECRET=
PUBLIC_URL=https://bestories.co.uk

PORT=3000
