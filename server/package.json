{
  "name": "be-stories-site",
  "version": "1.0.0",
  "private": true,
  "description": "be stories. \u2014 production site and booking service",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "python3 ../build.py",
    "start": "node --env-file=.env index.js",
    "dev": "node --watch --env-file=.env index.js",
    "auth": "node --env-file=.env auth.js",
    "verify": "node --env-file=.env verify.js",
    "test": "node --test test.js",
    "check": "npm test && npm run verify"
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "googleapis": "^144.0.0",
    "nodemailer": "^6.9.14"
  }
}